<iati-activity dstore:dataset="aecid-activity" dstore:index="30" default-currency="EUR" hierarchy="1" iati-activities:version="2.03" xml:lang="ES" xmlns:dstore="http://d-portal.org/xmlns/dstore" xmlns:iati-activities="http://d-portal.org/xmlns/iati-activities"><iati-identifier>XM-DAC-50-21-Z01-24-I1-01100</iati-identifier><reporting-org ref="XM-DAC-50-21" type="10"><narrative xml:lang="ES">AECID Agencia Española de Cooperación Internacional para el Desarrollo</narrative></reporting-org><title><narrative xml:lang="ES">Agricultura de precisión en Mozambique</narrative></title><description type="1"><narrative xml:lang="ES">El proyecto se desarrolla en las provincias de Cabo Delgado, Niassa y Maputo (Mozambique) y tiene como objetivo mejorar la seguridad alimentaria y las condiciones de vida de la población campesina usando tecnología aplicada a la agricultura. La intervención se orienta a comunidades rurales que tienen un acceso limitado a información técnica y a herramientas para la gestión de sus cultivos, lo que dificulta su capacidad de adaptación frente al cambio climático.
Título: Sistemas de teledetección agroclimática para una agricultura resiliente y de precisión en Mozambique</narrative></description><description type="2"><narrative xml:lang="ES">Mejorar la producción de 800 agricultores y agricultoras en Mozambique mediante el uso de información agroclimática en tiempo real y el apoyo a la gestión agrícola.</narrative></description><participating-org ref="XM-DAC-50-21" role="1" type="10"><narrative xml:lang="ES">AECID Agencia Española de Cooperación Internacional para el Desarrollo</narrative></participating-org><participating-org ref="ES-NIF-G78919271" role="2" type="22"><narrative xml:lang="ES">CESAL</narrative></participating-org><participating-org ref="ES-NIF-G78919271" role="4" type="22"><narrative xml:lang="ES">CESAL</narrative></participating-org><activity-status code="2"/><activity-date iso-date="2024-12-23" type="1"/><activity-date iso-date="2024-12-23" type="2"/><activity-date iso-date="2026-12-22" type="3"/><contact-info type="1"><organisation><narrative xml:lang="ES">AECID Spanish Agency for International Development Cooperation</narrative></organisation><telephone>+34900203054</telephone><email>centro.informacion@aecid.es</email><website>https://www.aecid.es</website><mailing-address><narrative xml:lang="ES">Av. Reyes Católicos 4, 28040 Madrid (Spain)</narrative></mailing-address></contact-info><activity-scope code="4"/><recipient-country code="MZ" percentage="100"/><location ref="MOZ"><location-reach code="1"/><location-id code="MZ" vocabulary="A4"/></location><sector code="15170" percentage="15" vocabulary="1"/><sector code="31120" percentage="35" vocabulary="1"/><sector code="32182" percentage="25" vocabulary="1"/><sector code="43071" percentage="10" vocabulary="1"/><sector code="74020" percentage="15" vocabulary="1"/><default-flow-type code="10"/><default-finance-type code="110"/><default-aid-type code="C01" vocabulary="1"/><default-tied-status code="5"/><budget status="2" type="2"><period-start iso-date="2024-12