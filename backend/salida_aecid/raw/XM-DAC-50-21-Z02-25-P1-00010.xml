<iati-activity dstore:dataset="aecid-activity" dstore:index="178" default-currency="EUR" hierarchy="1" iati-activities:version="2.03" xml:lang="ES" xmlns:dstore="http://d-portal.org/xmlns/dstore" xmlns:iati-activities="http://d-portal.org/xmlns/iati-activities"><iati-identifier>XM-DAC-50-21-Z02-25-P1-00010</iati-identifier><reporting-org ref="XM-DAC-50-21" type="10"><narrative xml:lang="ES">AECID Agencia Española de Cooperación Internacional para el Desarrollo</narrative></reporting-org><title><narrative xml:lang="ES">Mejora de la atención y prevención de la violencia de género hacia mujeres y niñas</narrative></title><description type="1"><narrative xml:lang="ES">La intervención refuerza la atención integral a mujeres víctimas de violencia de género y a los menores a su cargo mediante una red de asociaciones locales en varias provincias de Marruecos. El proyecto mejora la coordinación entre recursos sociales, sanitarios y jurídicos, y fortalece las capacidades de actores públicos y sociales que intervienen en la prevención y atención de la violencia. Asimismo, promueve la igualdad y la sensibilización entre jóvenes, impulsa el diálogo entre sociedad civil e instituciones y establece sistemas participativos de seguimiento y aprendizaje.
Título: Avanzando Juntas III: mejora de la atención integral a mujeres víctimas de violencia de género y menores mediante red de asociaciones en Marruecos</narrative></description><description type="2"><narrative xml:lang="ES">Mejorar la respuesta integral frente a la violencia de género y reforzar la prevención, la atención a las víctimas y la coordinación institucional y social.</narrative></description><participating-org ref="XM-DAC-50-21" role="1" type="10"><narrative xml:lang="ES">AECID Agencia Española de Cooperación Internacional para el Desarrollo</narrative></participating-org><participating-org ref="ES-NIF-G82484882" role="2" type="22"><narrative xml:lang="ES">AIDA - Ayuda, Intercambio y Desarrollo</narrative></participating-org><participating-org ref="ES-NIF-G82484882" role="4" type="22"><narrative xml:lang="ES">AIDA - Ayuda, Intercambio y Desarrollo</narrative></participating-org><activity-status code="2"/><activity-date iso-date="2026-01-01" type="1"/><activity-date iso-date="2026-01-01" type="2"/><activity-date iso-date="2027-12-31" type="3"/><contact-info type="1"><organisation><narrative xml:lang="ES">AECID Spanish Agency for International Development Cooperation</narrative></organisation><telephone>+34900203054</telephone><email>centro.informacion@aecid.es</email><website>https://www.aecid.es</website><mailing-address><narrative xml:lang="ES">Av. Reyes Católicos 4, 28040 Madrid (Spain)</narrative></mailing-address></contact-info><activity-scope code="4"/><recipient-country code="MA" percentage="100"/><location ref="MAR"><location-reach code="1"/><location-id code="MA" vocabulary="A4"/></location><sector code="15170" percentage="50" vocabulary="1"/><sector code="15180" percentage="50" vocabulary="1"/><default-flow-type code="10"/><default-finance-type code="110"/><default-aid-type code="C01" vocabulary="1"/><default-tied-status code="5"/><budget status="2" type="2"><period-start iso-date="2026-01-01"/><period-end iso-date="2026-03-31"/><value currenc