<iati-activity dstore:dataset="aecid-activity" dstore:index="17" default-currency="EUR" hierarchy="1" iati-activities:version="2.03" xml:lang="ES" xmlns:dstore="http://d-portal.org/xmlns/dstore" xmlns:iati-activities="http://d-portal.org/xmlns/iati-activities"><iati-identifier>XM-DAC-50-21-Z01-24-H1-01700</iati-identifier><reporting-org ref="XM-DAC-50-21" type="10"><narrative xml:lang="ES">AECID Agencia Española de Cooperación Internacional para el Desarrollo</narrative></reporting-org><title><narrative xml:lang="ES">Asistencia humanitaria y protección a mujeres y niñas en situación de vulnerabilidad en Burkina Faso</narrative></title><description type="1"><narrative xml:lang="ES">Este proyecto proporciona asistencia humanitaria y refuerza los mecanismos de protección para mujeres y niñas afectadas por la crisis alimentaria y el contexto de violencia. Las acciones incluyen acceso a alimentos, servicios de salud y apoyo frente a la violencia de género, así como el fortalecimiento de redes comunitarias de protección. La intervención contribuye a mejorar la seguridad, la dignidad y la resiliencia de las mujeres y niñas.
Título: Asistencia humanitaria y protección a las mujeres y niñas en situación de mayor vulnerabilidad en Burkina Faso</narrative></description><description type="2"><narrative xml:lang="ES">Mejorar el acceso de mujeres y niñas vulnerables a asistencia alimentaria, servicios de salud y protección frente a la violencia.</narrative></description><participating-org ref="XM-DAC-50-21" role="1" type="10"><narrative xml:lang="ES">AECID Agencia Española de Cooperación Internacional para el Desarrollo</narrative></participating-org><participating-org ref="ES-NIF-Q2866001G" role="2" type="22"><narrative xml:lang="ES">Cruz Roja Española</narrative></participating-org><participating-org ref="ES-NIF-Q2866001G" role="4" type="22"><narrative xml:lang="ES">Cruz Roja Española</narrative></participating-org><activity-status code="2"/><activity-date iso-date="2024-12-20" type="1"/><activity-date iso-date="2024-12-20" type="2"/><activity-date iso-date="2026-12-19" type="3"/><contact-info type="1"><organisation><narrative xml:lang="ES">AECID Spanish Agency for International Development Cooperation</narrative></organisation><telephone>+34900203054</telephone><email>centro.informacion@aecid.es</email><website>https://www.aecid.es</website><mailing-address><narrative xml:lang="ES">Av. Reyes Católicos 4, 28040 Madrid (Spain)</narrative></mailing-address></contact-info><activity-scope code="4"/><recipient-country code="BF" percentage="100"/><location ref="BFA"><location-reach code="1"/><location-id code="BF" vocabulary="A4"/></location><sector code="72040" percentage="100" vocabulary="1"/><default-flow-type code="10"/><default-finance-type code="110"/><default-aid-type code="C01" vocabulary="1"/><default-tied-status code="5"/><budget status="2" type="2"><period-start iso-date="2024-12-20"/><period-end iso-date="2025-03-19"/><value currency="EUR" value-date="2024-12-20">121545</value></budget><budget status="2" type="2"><period-start iso-date="2025-03-20"/><period-end iso-date="2025-06-19"/>