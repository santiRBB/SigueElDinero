<iati-activity dstore:dataset="aecid-activity" dstore:index="361" default-currency="EUR" hierarchy="1" iati-activities:version="2.03" xml:lang="ES" xmlns:dstore="http://d-portal.org/xmlns/dstore" xmlns:iati-activities="http://d-portal.org/xmlns/iati-activities"><iati-identifier>XM-DAC-50-21-Z03-24-01-14800</iati-identifier><reporting-org ref="XM-DAC-50-21" type="10"><narrative xml:lang="ES">AECID Agencia Española de Cooperación Internacional para el Desarrollo</narrative></reporting-org><title><narrative xml:lang="ES">Autonomía económica de mujeres lencas en Honduras</narrative></title><description type="1"><narrative xml:lang="ES">El proyecto se desarrolla en el departamento de Intibucá (Honduras) y tiene como objetivo fortalecer la autonomía económica de las mujeres campesinas lencas en un contexto marcado por altas tasas de pobreza y limitada igualdad de oportunidades. En esta región, más del 64 % de la población vive en situación de pobreza y más del 40 % en pobreza extrema, mientras que las mujeres rurales afrontan importantes barreras para acceder a la tierra, al crédito y a los mercados.
Título: Autonomía económica de las mujeres lencas de Honduras</narrative></description><description type="2"><narrative xml:lang="ES">Mejorar la autonomía económica de 200 mujeres campesinas lencas en Intibucá, facilitando su acceso a la tierra, el crédito y los mercados, y fortaleciendo sus capacidades para generar ingresos sostenibles.</narrative></description><participating-org ref="XM-DAC-50-21" role="1" type="10"><narrative xml:lang="ES">AECID Agencia Española de Cooperación Internacional para el Desarrollo</narrative></participating-org><participating-org ref="ES-NIF-019004511627" role="2" type="60"><narrative xml:lang="ES">AMIR - Asociación de Mujeres Intibucanas Renovadas</narrative></participating-org><participating-org ref="ES-NIF-019004511627" role="4" type="60"><narrative xml:lang="ES">AMIR - Asociación de Mujeres Intibucanas Renovadas</narrative></participating-org><activity-status code="2"/><activity-date iso-date="2024-12-30" type="1"/><activity-date iso-date="2024-12-30" type="2"/><activity-date iso-date="2026-12-29" type="3"/><contact-info type="1"><organisation><narrative xml:lang="ES">AECID Spanish Agency for International Development Cooperation</narrative></organisation><telephone>+34900203054</telephone><email>centro.informacion@aecid.es</email><website>https://www.aecid.es</website><mailing-address><narrative xml:lang="ES">Av. Reyes Católicos 4, 28040 Madrid (Spain)</narrative></mailing-address></contact-info><activity-scope code="4"/><recipient-country code="HN" percentage="100"/><location ref="HND"><location-reach code="1"/><location-id code="HN" vocabulary="A4"/></location><sector code="15170" percentage="100" vocabulary="1"/><default-flow-type code="10"/><default-finance-type code="110"/><default-aid-type code="C01" vocabulary="1"/><default-tied-status code="5"/><budget status="2" type="2"><period-start iso-date="2024-12-30"/><period-end iso-date="2025-03-29"/><value currency="EUR" value-date="2024-12-30">27739.6</value></budget><budget st