<iati-activity dstore:dataset="aecid-activity" dstore:index="372" default-currency="EUR" hierarchy="1" iati-activities:version="2.03" xml:lang="ES" xmlns:dstore="http://d-portal.org/xmlns/dstore" xmlns:iati-activities="http://d-portal.org/xmlns/iati-activities"><iati-identifier>XM-DAC-50-21-Z03-24-01-16000</iati-identifier><reporting-org ref="XM-DAC-50-21" type="10"><narrative xml:lang="ES">AECID Agencia Española de Cooperación Internacional para el Desarrollo</narrative></reporting-org><title><narrative xml:lang="ES">Mejora del acceso al agua y saneamiento en la cuenca de Lambaré</narrative></title><description type="1"><narrative xml:lang="ES">El proyecto mejora las condiciones ambientales y de salud en la cuenca de Lambaré, en el área metropolitana de Asunción, mediante el refuerzo de infraestructuras de agua potable y saneamiento. La intervención prioriza hogares y espacios públicos en situación de vulnerabilidad y promueve una gestión social participativa que contribuye a la sostenibilidad de los servicios. Lo hace con un apoyo específico a la construcción de infraestructuras de acceso a agua, conexiones a red de alcantarillado y soluciones individuales de saneamiento, la promoción hábitos de  higiene y uso racional de agua, y el desarrollo productivo local en torno al sector.
Título: Mejora  del acceso al agua y saneamiento en zonas vulnerables de la cuenca del Lambaré, Paraguay</narrative></description><description type="2"><narrative xml:lang="ES">Mejorar el acceso al agua potable y al saneamiento con enfoque de sostenibilidad y participación social.</narrative></description><participating-org ref="XM-DAC-50-21" role="1" type="10"><narrative xml:lang="ES">AECID Agencia Española de Cooperación Internacional para el Desarrollo</narrative></participating-org><participating-org ref="ES-NIF-000080016513" role="2" type="24"><narrative xml:lang="ES">CEAMSO - Centro de Estudios Ambientales y Sociales</narrative></participating-org><participating-org ref="ES-NIF-000080016513" role="4" type="24"><narrative xml:lang="ES">CEAMSO - Centro de Estudios Ambientales y Sociales</narrative></participating-org><activity-status code="2"/><activity-date iso-date="2024-10-22" type="1"/><activity-date iso-date="2024-10-22" type="2"/><activity-date iso-date="2027-09-06" type="3"/><contact-info type="1"><organisation><narrative xml:lang="ES">AECID Spanish Agency for International Development Cooperation</narrative></organisation><telephone>+34900203054</telephone><email>centro.informacion@aecid.es</email><website>https://www.aecid.es</website><mailing-address><narrative xml:lang="ES">Av. Reyes Católicos 4, 28040 Madrid (Spain)</narrative></mailing-address></contact-info><activity-scope code="4"/><recipient-country code="PY" percentage="100"/><location ref="PRY"><location-reach code="1"/><location-id code="PY" vocabulary="A4"/></location><sector code="14031" percentage="100" vocabulary="1"/><default-flow-type code="10"/><default-finance-type code="110"/><default-aid-type code="B033" vocabulary="1"/><default-tied-status code="5"/><budget status="2" type="2"><period-start iso-date="2024-10-22"/><period-end iso-date="2025-01-21"/><value currency="EUR" value-date="2024-10-22">155699.05</value></budget><budget status="2" type="2"><period-start iso-date="2025-01-22"/>