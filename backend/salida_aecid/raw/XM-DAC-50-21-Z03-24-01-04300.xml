<iati-activity dstore:dataset="aecid-activity" dstore:index="288" default-currency="EUR" hierarchy="1" iati-activities:version="2.03" xml:lang="ES" xmlns:dstore="http://d-portal.org/xmlns/dstore" xmlns:iati-activities="http://d-portal.org/xmlns/iati-activities"><iati-identifier>XM-DAC-50-21-Z03-24-01-04300</iati-identifier><reporting-org ref="XM-DAC-50-21" type="10"><narrative xml:lang="ES">AECID Agencia Española de Cooperación Internacional para el Desarrollo</narrative></reporting-org><title><narrative xml:lang="ES">Prevención de la violencia de género y la trata de personas</narrative></title><description type="1"><narrative xml:lang="ES">El proyecto se desarrolla en los distritos de Urcos (provincia de Quispicanchi, región Cusco), Iquitos (provincia de Maynas, región Loreto) y San Juan de Lurigancho (región Lima), con el objetivo de prevenir la violencia de género y la trata de personas en contextos marcados por alta vulnerabilidad social. Estas zonas presentan factores de riesgo como la tolerancia social a la violencia, la debilidad en la coordinación institucional, la presencia de economías informales e ilegales y limitaciones en la cobertura y calidad de los servicios de atención.
Título: Uniendo esfuerzos para prevenir la violencia de género y la trata de personas en Cuzco, Loreto y Lima, Perú</narrative></description><description type="2"><narrative xml:lang="ES">Prevenir la violencia de género y la trata de personas en Cusco, Loreto y Lima, fortaleciendo la respuesta institucional y comunitaria y mejorando la protección de mujeres y niñas en riesgo.</narrative></description><participating-org ref="XM-DAC-50-21" role="1" type="10"><narrative xml:lang="ES">AECID Agencia Española de Cooperación Internacional para el Desarrollo</narrative></participating-org><participating-org ref="ES-NIF-20509528510" role="2" type="24"><narrative xml:lang="ES">Capital Humano y Social Alternativo</narrative></participating-org><participating-org ref="ES-NIF-20509528510" role="4" type="24"><narrative xml:lang="ES">Capital Humano y Social Alternativo</narrative></participating-org><activity-status code="2"/><activity-date iso-date="2024-05-14" type="1"/><activity-date iso-date="2024-05-14" type="2"/><activity-date iso-date="2025-05-13" type="3"/><contact-info type="1"><organisation><narrative xml:lang="ES">AECID Spanish Agency for International Development Cooperation</narrative></organisation><telephone>+34900203054</telephone><email>centro.informacion@aecid.es</email><website>https://www.aecid.es</website><mailing-address><narrative xml:lang="ES">Av. Reyes Católicos 4, 28040 Madrid (Spain)</narrative></mailing-address></contact-info><activity-scope code="4"/><recipient-country code="PE" percentage="100"/><location ref="PER"><location-reach code="1"/><location-id code="PE" vocabulary="A4"/></location><sector code="15180" percentage="100" vocabulary="1"/><default-flow-type code="10"/><default-finance-type code="110"/><default-aid-type code="C01" vocabulary="1"/><default-tied-status code="5"/><budget status="2" type="2"><period-start iso-date="2024-05-14"/><period-end iso-date="2024-08-13"/><value currency="EUR" value-date="2024-05-14">75616.44</value></budget><b