<iati-activity dstore:dataset="aecid-activity" dstore:index="223" default-currency="EUR" hierarchy="1" iati-activities:version="2.03" xml:lang="ES" xmlns:dstore="http://d-portal.org/xmlns/dstore" xmlns:iati-activities="http://d-portal.org/xmlns/iati-activities"><iati-identifier>XM-DAC-50-21-Z02-25-P1-00058</iati-identifier><reporting-org ref="XM-DAC-50-21" type="10"><narrative xml:lang="ES">AECID Agencia Española de Cooperación Internacional para el Desarrollo</narrative></reporting-org><title><narrative xml:lang="ES">Mujeres mayas unidas para vivir sin violencias en Sololá</narrative></title><description type="1"><narrative xml:lang="ES">El proyecto trabaja para reducir las desigualdades de género y combatir la violencia y el racismo que afectan a mujeres mayas de distintos pueblos en el departamento de Sololá. A través del fortalecimiento de organizaciones de mujeres, se promueven acciones de prevención y atención integral. La intervención impulsa la acción colectiva, la incidencia social y el cumplimiento de los marcos legales, reforzando las capacidades de las mujeres para ejercer sus derechos desde su identidad cultural y su participación activa en la vida comunitaria.
Título: Mujeres Mayas tejiendo redes y saberes para una vida libre de violencias en Sololá, Guatemala</narrative></description><description type="2"><narrative xml:lang="ES">Fortalecer las capacidades de las organizaciones de mujeres mayas para prevenir, atender y exigir el cumplimiento de los derechos frente a las violencias y las desigualdades.</narrative></description><participating-org ref="XM-DAC-50-21" role="1" type="10"><narrative xml:lang="ES">AECID Agencia Española de Cooperación Internacional para el Desarrollo</narrative></participating-org><participating-org ref="ES-NIF-G58236803" role="2" type="22"><narrative xml:lang="ES">Fundación Oxfam Intermón</narrative></participating-org><participating-org ref="ES-NIF-G58236803" role="4" type="22"><narrative xml:lang="ES">Fundación Oxfam Intermón</narrative></participating-org><activity-status code="2"/><activity-date iso-date="2026-01-01" type="1"/><activity-date iso-date="2026-01-01" type="2"/><activity-date iso-date="2027-12-31" type="3"/><contact-info type="1"><organisation><narrative xml:lang="ES">AECID Spanish Agency for International Development Cooperation</narrative></organisation><telephone>+34900203054</telephone><email>centro.informacion@aecid.es</email><website>https://www.aecid.es</website><mailing-address><narrative xml:lang="ES">Av. Reyes Católicos 4, 28040 Madrid (Spain)</narrative></mailing-address></contact-info><activity-scope code="4"/><recipient-country code="GT" percentage="100"/><location ref="GTM"><location-reach code="1"/><location-id code="GT" vocabulary="A4"/></location><sector code="15150" percentage="20" vocabulary="1"/><sector code="15160" percentage="10" vocabulary="1"/><sector code="15180" percentage="70" vocabulary="1"/><default-flow-type code="10"/><default-finance-type code="110"/><default-aid-type code="C01" vocabulary="1"/><default-tied-status code="5"/><budget status="2" type="2"><period-start iso-date="2026-01-01"/><period-end iso-date="2026-03-31"/><value currency="EUR" va