<iati-activity dstore:dataset="aecid-activity" dstore:index="253" default-currency="EUR" hierarchy="1" iati-activities:version="2.03" xml:lang="ES" xmlns:dstore="http://d-portal.org/xmlns/dstore" xmlns:iati-activities="http://d-portal.org/xmlns/iati-activities"><iati-identifier>XM-DAC-50-21-Z03-24-01-00300</iati-identifier><reporting-org ref="XM-DAC-50-21" type="10"><narrative xml:lang="ES">AECID Agencia Española de Cooperación Internacional para el Desarrollo</narrative></reporting-org><title><narrative xml:lang="ES">Promoción de los derechos de las víctimas en Chocó y Valle del Cauca (Colombia)</narrative></title><description type="2"><narrative xml:lang="ES">Contribuir a la reparación simbólica y a la dignificación de las víctimas del conflicto armado mediante procesos participativos de memoria histórica.</narrative></description><description type="1"><narrative xml:lang="ES">La intervención apoya procesos participativos de memoria histórica en los departamentos de Chocó y Valle del Cauca, con el objetivo de contribuir a la reparación simbólica y a la dignificación de las víctimas del conflicto armado en Colombia. El proyecto parte de las experiencias, saberes y voces de las comunidades afectadas. A través de acciones pedagógicas, archivos sociales de derechos humanos y la creación o fortalecimiento de espacios y lugares de memoria, se impulsa la apropiación social de la memoria histórica y su difusión, favoreciendo el reconocimiento de las víctimas y la construcción de una paz duradera.
Título: El territorio habla y el Centro Nacional de Memoria escucha: promoviendo  derechos de las víctimas en el Chocó y Valle del Cauca, Colombia</narrative></description><participating-org ref="XM-DAC-50-21" role="1" type="10"><narrative xml:lang="ES">AECID Agencia Española de Cooperación Internacional para el Desarrollo</narrative></participating-org><participating-org ref="ES-NIF-009004921415" role="2" type="15"><narrative xml:lang="ES">Centro Nacional de Memoria Histórica</narrative></participating-org><participating-org ref="ES-NIF-009004921415" role="4" type="15"><narrative xml:lang="ES">Centro Nacional de Memoria Histórica</narrative></participating-org><activity-status code="2"/><activity-date iso-date="2025-04-30" type="1"/><activity-date iso-date="2025-04-30" type="2"/><activity-date iso-date="2027-04-29" type="3"/><contact-info type="1"><organisation><narrative xml:lang="ES">AECID Spanish Agency for International Development Cooperation</narrative></organisation><telephone>+34900203054</telephone><email>centro.informacion@aecid.es</email><website>https://www.aecid.es</website><mailing-address><narrative xml:lang="ES">Av. Reyes Católicos 4, 28040 Madrid (Spain)</narrative></mailing-address></contact-info><activity-scope code="4"/><recipient-country code="CO" percentage="100"/><location ref="COL"><location-reach code="1"/><location-id code="CO" vocabulary="A4"/></location><sector code="15230" percentage="100" vocabulary="1"/><default-flow-type code="10"/><default-finance-type code="110"/><default-aid-type code="C01" vocabulary="1"/><default-tied-status code="5"/><budget status="2" type="2"><period-start iso-date="2025-04-30"/><period-end iso-date="2025-07-29"/><value currency="EUR" value-date="2025-04-30">49863.01</value></budget><budget status="2" type="2"><period-start iso-date="2025-07-30"/><period-end iso-date="2025-10-29"/><value currency="EUR" value-date="2025-07-30">50410.96</value></budget><budget status="2" type="2"><period-start iso-date="2025-10